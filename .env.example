# API-прокси (OpenAI-формат для Gemini, Anthropic-формат для Anthropic)
STAR_API_KEY=
STAR_BASE_URL=https://ai.starimg.ru

# Telegram
TELEGRAM_BOT_TOKEN=
# Telegram ID администраторов через запятую (доступ к /debug и /stats)
ADMIN_IDS=
# 1 — показывать /debug всем (удобно на время проверки)
PUBLIC_DEBUG=0

# Ограничения
DAILY_BUDGET_TOKENS=2000000
# 1 — писать в трейсы сырой текст сообщений
DEBUG_TRACES=0
# Соль для хэширования user_id в трейсах
TRACE_SALT=change-me
